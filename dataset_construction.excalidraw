      "updated": 1789148305675,
      "link": null,
      "locked": false,
      "text": "LLM step 2:\nfor each case and all contracts discussed in the case, extract all the clauses that are\ndisputed (as high risky clauses)\nfor each disputed clause, extract all the issues related to it -- because on court, the\ntwo sides may dispute a clause regarding more than one aspects, revealing multiple\npotential issues in the clause",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLM step 2:\nfor each case and all contracts discussed in the case, extract all the clauses that are disputed (as high risky clauses)\nfor each disputed clause, extract all the issues related to it -- because on court, the two sides may dispute a clause regarding more than one aspects, revealing multiple potential issues in the clause",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1789147971795,
      "labelPosition": null,
      "baseFontSize": null
    },
