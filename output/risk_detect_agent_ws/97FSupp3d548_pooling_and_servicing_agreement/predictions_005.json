{"clause_id": "c249", "issues": [
  {"issue": "The 'Prepayment Assumption' is fixed only by reference to a Prospectus Supplement that is not itself part of the Agreement or attached as an exhibit. The operative rate cannot be determined from the four corners of the instrument.", "type": 1, "prob": 0.19},
  {"issue": null, "type": 2, "prob": 0.10}]},
