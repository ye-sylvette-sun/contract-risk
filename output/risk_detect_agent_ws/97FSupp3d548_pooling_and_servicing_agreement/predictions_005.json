{"clause_id": "c254", "issues": [
  {"issue": "The closing words 'or any replacement policy therefor through the related Interest Accrual Period for such Class relating to a Distribution Date' attach a certificate-class concept to an insurance policy and have no discernible meaning. The sentence as drafted does not parse.", "type": 1, "prob": 0.22},
  {"issue": null, "type": 2, "prob": 0.09}]},
