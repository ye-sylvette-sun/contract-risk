          "text": "{\"case_desc\":\"The New York Times and the Fund disputed whether the CBA measured pension contributions by shifts or wages and whether the Trust Agreement’s 18% default rate covered withdrawal-liability payments.\",\"clauses\":[{\"clause_name\":\"Section 13-I.1 — Pension Fund Contributions\",\"taxonomy\":[\"1.1\"],\"contract_id\":\"303FSupp3d236_multiemployer_collective_bargaining_agreement\",\"start_line\":2703,\"end_line\":2711,\"head\":\"Pension Fund 13-I, 1, The Publisher agrees it\",\"tail\":\"in any one Office for any one employee.\",\"opinion_comment_start_line\":55,\"opinion_comment_end_line\":68},{\"clause_name\":\"Amendment No. 2 to Section 9.5(b) — Default in Payment\",\"taxonomy\":[\"1.1\"],\"contract_id\":\"303FSupp3d236_fund_s_trust_agreement\",\"start_line\":3329,\"end_line\":3333,\"head\":\"(b) A delinquent Employer shall be liable for\",\"tail\":\"Trustees deem appropriate given vcumstance : 7 :\",\"opinion_comment_start_line\":130,\"opinion_comment_end_line\":131}]}",
