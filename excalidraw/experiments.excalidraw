    {
      "id": "YJBcTQgX7nSL177pk2Zjg",
      "type": "text",
      "x": -326.28533935546875,
      "y": 151.07154083251953,
      "width": 814.9993896484375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
