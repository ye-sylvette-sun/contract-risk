      "roundness": null,
      "seed": 746809261,
      "version": 503,
      "versionNonce": 1230081069,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789148771268,
      "link": null,
      "locked": false,
      "text": "Notes on agent run:\n1. Agent only allow to read the contract file, and write the answer\n    No external skills, web search, code execution is NOT allowed\n    No memory\n2. Agent run in a \"docker container\" -- an isolated environment from personal device",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notes on agent run:\n1. Agent only allow to read the contract file, and write the answer\n    No external skills, web search, code execution is NOT allowed\n    No memory\n2. Agent run in a \"docker container\" -- an isolated environment from personal device",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "r7vzVr9Y9AcVJILaY7d4o",
      "type": "text",
      "x": -682.5463811480811,
      "y": -62.75396801176532,
      "width": 515.2796630859375,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6J",
      "roundness": null,
      "seed": 1310773635,
      "version": 557,
      "versionNonce": 703561613,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789148757915,
      "link": null,
      "locked": false,
      "text": "Phase 1 Done\nbuild dataset\nrun AI experiments\n\n1000 clauses -- 19 real risk clause -- 981 low risk\n\nthreshold 0.4 -- warning/flag 15% = 150 clauses\nprecision 0.1 -- 15 clauses do have real risk\nrecall 0.8 -- 15 real risk is 80% of all risk clauses\n                15 = 19 x 80%\n\n\nPhase 2\nadd traps to contracts in dataset\nrun AI experiments again:\n    except AI precision/recall drops\n\n\nPhase 3\nimprove AI prediction approach on trapped contracts\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Phase 1 Done\nbuild dataset\nrun AI experiments\n\n1000 clauses -- 19 real risk clause -- 981 low risk\n\nthreshold 0.4 -- warning/flag 15% = 150 clauses\nprecision 0.1 -- 15 clauses do have real risk\nrecall 0.8 -- 15 real risk is 80% of all risk clauses\n                15 = 19 x 80%\n\n\nPhase 2\nadd traps to contracts in dataset\nrun AI experiments again:\n    except AI precision/recall drops\n\n\nPhase 3\nimprove AI prediction approach on trapped contracts\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
