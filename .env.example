# The dataset build (steps 0b, 1, 2) runs on OpenAI.
OPENAI_API_KEY=sk-proj-...

# The risk-detection experiment's credential, from `claude setup-token`. The experiment is
# src/experiments/risk_detect_agent.py, which runs the Claude Code CLI in a container
# and bills the Claude Code subscription. See README.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# NOT needed. The one-shot API arm has been retired and deleted, and nothing in
# the pipeline calls the Anthropic API directly. Set this only if you revive it
# from `2026.9.3_legacy_multi_issue_experiment` —
# the agent run never sees it, because `docker run` is given only
# -e CLAUDE_CODE_OAUTH_TOKEN and isolation.env() strips every ANTHROPIC_*
# variable inside the container before the SDK starts.
# ANTHROPIC_API_KEY=sk-ant-...
